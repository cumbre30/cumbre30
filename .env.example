# Base de datos Postgres.
#  · Desarrollo local: bash scripts/setup-postgres-dev.sh
#  · Producción (Vercel + Neon): la URL la crea Vercel al crear la
#    base (Storage → Create database) o en console.neon.tech
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/cumbre30

# --- Auto-entrega de códigos Cumbre30 Pro (download/autogestion-codigos.md)
# Token de producción de Mercado Pago (Tus integraciones → credenciales de producción)
MP_ACCESS_TOKEN=
# Correo Gmail desde el que se envían los códigos + contraseña de aplicación (16 caracteres, con 2FA activo)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Secreto que protege /api/mp/sync y /api/pro/send-code (cron y respaldo manual)
MP_SYNC_TOKEN=
# Monto del plan Pro en CLP (default 6500)
MP_PRO_AMOUNT=6500

# --- Distribución del APK en producción
# En Vercel el APK de ~54 MB no viaja en la función: sube el archivo a un
# GitHub Release y pega aquí su URL de descarga (el /api/apk redirige).
# Sin esta variable, /api/apk sirve el archivo local (dev/sandbox).
APK_DOWNLOAD_URL=

# --- Web Push (Ola 2): avisos del parque en la web (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: del remitente declarado al servicio de push
VAPID_SUBJECT=mailto:contacto@cumbregeo.cl
# Secreto que protege el envío masivo por /api/push/send (curl del administrador)
PUSH_ADMIN_KEY=
