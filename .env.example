DATABASE_URL=file:./db/custom.db

# --- Auto-entrega de códigos Cumbre30 Pro (download/autogestion-codigos.md)
# Token de producción de Mercado Pago (Tus integraciones → credenciales de producción)
MP_ACCESS_TOKEN=
# Correo Gmail desde el que se envían los códigos + contraseña de aplicación (16 caracteres, con 2FA activo)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Secreto que protege /api/mp/sync y /api/pro/send-code (cron y respaldo manual)
MP_SYNC_TOKEN=
# Monto del plan Pro en CLP (default 6500)
MP_PRO_AMOUNT=6500
