# ============================================
# Cumbre30 — .gitignore
# Lo que NO se sube: dependencias, builds,
# bases de datos locales, APKs y archivos del
# entorno de trabajo.
# ============================================

# --- Dependencias ---
node_modules/
/.pnp
.pnp.*

# --- Next.js ---
/.next/
/build-static/
/out/
next-env.d.ts

# --- Entorno y secretos ---
.env
.env.*
!.env.example

# --- Bases de datos locales (se crean solas) ---
db/*.db
db/*.db-journal
*.sqlite

# --- APKs y empaquetado nativo ---
*.apk
/android/app/build/
/android/app/src/main/assets/public/
/android/.gradle/
/android/build/
/android/local.properties
/android/.idea/
/android/captures/

# --- Herramientas del entorno de trabajo (no son del proyecto) ---
/tools/
/skills/
/examples/
/mini-services/
/tool-results/
/upload/
/download/
/.claude/
/.z-ai-config

# --- Capturas y archivos de trabajo del asistente ---
/scripts/shot*.png
/scripts/*.log

# --- Logs y basura ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Otros ---
/coverage/
*.tsbuildinfo
.vercel
*.pem

# --- Scripts del entorno de trabajo (no del proyecto) ---
/.zscripts/

# --- Descarga temporal via preview (no es parte del proyecto) ---
/public/descargas/

# zip temporal servido por el preview (no entra al repo)
public/cumbre30-github.zip

# Postgres embebido local: data dir vivo, no va al repo
/db/pgdata/
db/pg.log
public/cumbre30-codigo.zip
