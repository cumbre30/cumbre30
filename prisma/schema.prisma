generator client {
  provider      = "prisma-client-js"
  // "native" = el motor del sistema donde se genera (dev/sandbox).
  // "rhel-openssl-3.0.x" = el runtime de las funciones serverless de
  // Vercel (Amazon Linux 2023). Sin este target el build pasa pero el
  // login/rides/pagos fallan en producción con "Prisma Client could not
  // locate the Query Engine for runtime rhel-openssl-3.0.x".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Cumbre30 — esquema de datos
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  // Regla: el nombre de usuario se puede cambiar solo 1 vez cada 30 días.
  // Las estadísticas quedan asociadas al correo/id, no al nombre.
  usernameChangedAt DateTime?
  passwordHash      String
  selectedPin       String    @default("clasico")
  // Datos de la bicicleta
  bikeBrand         String?
  bikeType          String?
  bikeModel         String?
  bikeSize          String?
  bikeColor         String?
  // Pesos del conjunto (v1.13.17): alimentan la estimación de watts en
  // subidas >4% que hace el dispositivo al cerrar el ride. La copia en
  // la cuenta es respaldo por si se cambia de teléfono; el dispositivo
  // (localStorage) es la fuente de verdad una vez que el usuario guardó.
  riderWeightKg     Float?
  bikeWeightKg      Float?
  createdAt         DateTime  @default(now())

  // Rol para la moderación de contenido comunitario (fase A del módulo
  // Rutas y Comunidad, v2.1): user | moderador | admin. La transición
  // inicial se protege con la clave admin timing-safe (lib/adminKey.ts);
  // el rol autoriza /api/moderation (fase E).
  role              String    @default("user")

  sessions         Session[]
  rides            Ride[]
  incidents        Incident[]
  achievements     Achievement[]
  cyclistProfile   CyclistProfile?
  initiated        Friendship[]  @relation("friendInitiator")
  received         Friendship[]  @relation("friendReceiver")
  // Módulo Rutas y Comunidad (fase A): rutas propias y participaciones.
  routes           Route[]
  routeComments    RouteComment[]
  routeRatings     RouteRating[]
  routeReports     RouteReport[]
  routeExperiences RouteExperience[]
  routeFavorites   RouteFavorite[]
  culturaFavoritos CulturaFavorito[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Restablecimiento de contraseña: código de 6 dígitos entregado por
// soporte (WhatsApp/correo) tras verificar la identidad del ciclista.
// Sin envío de email automático: no hay SMTP en este despliegue.
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Entrega de códigos Cumbre30 Pro (auto-gestión de la venta web).
// paymentId único = idempotencia: un pago de Mercado Pago entrega
// exactamente UN código aunque el webhook o el sync se repitan.
model ProDelivery {
  id        String   @id @default(cuid())
  paymentId String   @unique
  email     String
  code      String
  amount    Int
  via       String // webhook | sync | manual
  createdAt DateTime @default(now())

  @@index([email])
}

model Ride {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateISO      DateTime
  source       String // "gps" | "sim"
  distanceKm   Float
  maxKmh       Float
  maxInParkKmh Float?
  // Kilómetros recorridos DENTRO de la geocerca del parque (null en
  // rides antiguos o que nunca entraron). Los desafíos del parque usan
  // este valor, no la distancia total del ride.
  inParkKm     Float?
  // True si el ride se registró en vehículo motorizado (sospecha del
  // motor confirmada por el usuario): no cuenta para desafíos ni stats.
  motorized    Boolean  @default(false)
  // id del ride en el dispositivo (summary.id) para poder corregir el
  // flag motorizado desde el cliente (PATCH /api/rides).
  clientId     String?
  avgKmh       Float
  elapsedSec   Float
  gainM        Float
  overLimitSec Float
  createdAt    DateTime @default(now())

  // Métricas derivadas del track (Perfil Ciclista, v1.13.16): las
  // calcula el DISPOSITIVO al cerrar el ride (el track crudo nunca
  // sale del teléfono) y el servidor las guarda 1:1 con el ride.
  metric RideMetric?

  @@index([userId, dateISO])
}

// ---------- Perfil Ciclista (fase 1, v1.13.16) ----------
// Métricas derivadas por ride. Idempotente por rideId (1:1). Un ride
// sin metric (anteriores a v1.13.16) sigue contando para los ejes que
// no la necesitan (Resistencia, Constancia y la densidad de desnivel
// de Escalada, vía Ride.gainM).
model RideMetric {
  rideId          String   @id
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  movingSec       Float
  // Velocidad: P95 de tramos en llano (|pendiente| ≤ 1.5%) y media
  // ponderada por km en llano. Denominadores del perfil: 52 / 36 km/h.
  peak15sKmh      Float?
  flatAvgKmh      Float?
  flatKm          Float?
  // Escalada: metros ganados y segundos en movimiento con pendiente >4%
  // (grupos ≥3 m con histéresis) → VAM = m·3600/s si hubo ≥60 s subiendo.
  climbGainM      Float?
  climbSec        Float?
  vamMh           Float?
  // Paradas: grupos a <2.5 km/h por más de 15 s (base del arquetipo URBAN).
  stopCount       Int?
  // Antitrampa: tiempo sobre 55 km/h, tramo continuo más largo sobre ese
  // umbral y media en pendientes >6% (>28 km/h = vehículo → ride inválido).
  secOver55       Float?
  over55StreakSec Float?
  climb6AvgKmh    Float?
  // v1.13.17: watts estimados en subida >4% (modelo gravedad+rodamiento
  // +aire con los pesos del conjunto, calculado en el dispositivo) y km
  // off-road/neto del eje Exploración (superficie según la red de
  // navegación: path/track = off-road; null = sin medición).
  estWattsClimb   Float?
  offRoadKm       Float?
  netKm           Float?
  // Marcado false por el motor de perfil si la física no calza con una bici.
  isValid         Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// Perfil materializado del ciclista (lectura rápida para la UI): 6 ejes
// 0–100 + arquetipo. Se recalcula al guardar cada ride (y al corregir el
// flag motorizado) con ventana móvil de 90 días y decaimiento exponencial
// (vida media ~45 días). Archetypes: CALIBRATING, URBAN, CLIMBER,
// ENDURANCE, TIME_TRIALIST, SPRINTER, EXPLORER, ALL_ROUNDER.
model CyclistProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  archetype   String
  calibrating Boolean  @default(true)
  climbing    Float?
  endurance   Float?
  speed       Float?
  power       Float?
  consistency Float?
  // v1.13.17: km off-road (Exploración, superficie path/track de la red).
  explorer    Float?
  validRides  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// Remote Config de los techos del perfil (v1.13.17): una fila por clave
// (techoMkm, techoVam, techoEndu, techoLlano, techoPico, techoOffroad).
// Editable sin release vía PUT /api/profile-config con x-admin-key; el
// motor mezcla con los defaults de lib/profileConfig al recalcular.
model ProfileConfig {
  key       String   @id
  value     Float
  updatedAt DateTime @updatedAt
}

model Incident {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // pozo | vidrio | perro | cierre | arbol | peaton | otro
  lat       Float
  lon       Float
  note      String?
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  // Moderación comunitaria (Ola 1): la comunidad confirma frescura o
  // cierra el reporte; sin confirmaciones en 30 días el feed lo expira.
  confirmCount  Int       @default(0)
  resolvedCount Int       @default(0)
  lastConfirmAt DateTime?
  // v1.13.14: denuncias de abuso (política UGC de Play); 2 cierran el reporte.
  reportCount   Int       @default(0)

  @@index([lat, lon])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("friendInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("friendReceiver", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

// ============================================================
// Registro en línea de constancias de trayecto (2026-11-14).
// La app registra cada constancia emitida (POST /api/constancias)
// y la página pública /verificar consulta por el hash SHA-256 para
// confirmar que el documento fue emitido por la app ese día.
// id = hash SHA-256 del contenido (64 hex): idempotente, una misma
// constancia re-emitida no duplica filas.
// ============================================================
model Constancia {
  id        String   @id // hash SHA-256 del payload (hex 64)
  rideId    String
  payload   Json
  createdAt DateTime @default(now())

  @@index([rideId])
}

// ============================================================
// Suscripciones Web Push (Ola 2): avisos del parque en la web
// (luces, cierres, incidentes). Una fila por endpoint del
// navegador; userId opcional (cuenta con sesión) para avisos
// personales (envío de prueba). El endpoint caducado se elimina
// al enviar (404/410 del servicio de push).
// ============================================================
model PushSub {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())
}

// ============================================================
// Enlaces públicos de ride (Ola 3): código corto compartible
// (cumbregeo.cl/compartir?c=CÓDIGO) que muestra las estadísticas
// del viaje. Solo stats: sin GPS del trazado (privacidad) y solo
// con opt-in del dueño (crea el enlace desde Historial).
// ============================================================
model RideShare {
  id        String   @id @default(cuid())
  code      String   @unique
  rideId    String
  createdAt DateTime @default(now())
}

// ============================================================
// Rutas y Comunidad (fase A, arquitectura v2.1 del 21-11-2026).
// ROUTE-ACTIVITY-SEGMENT: la ruta pública vive SOLO con su geometría
// protegida (el original queda en el dispositivo del creador);
// los rides y experiencias anclan a RouteVersion para sobrevivir a
// ediciones; las unicidades de participación son @@unique compuestos
// (patrón Friendship/Achievement). Consultas geográficas por columnas
// dedicadas (bbox + cells geohash, índice GIN) — nunca decodificando
// la polyline (v2.1: cells incluye TODAS las celdas que toca la
// geometría, con fallback geohash-4 si supera 64).
// ============================================================

model Route {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nombre        String // ≤ 80, validado en API
  descripcion   String? // ≤ 2000
  modalidad     String // urbana | montana | mixta (abierto a futuras)
  // Geometría pública protegida: polyline codificada (formato de
  // entrega) + bbox exacto de la geometría (predicado de intersección
  // corregido v2.1: minLat<=norte AND maxLat>=sur AND minLon<=este AND
  // maxLon>=oeste) y celdas tocadas (hasSome en la consulta).
  polyline      String
  coordsPubVer  Int      @default(1)
  minLat        Float
  maxLat        Float
  minLon        Float
  maxLon        Float
  cells         String[]
  centerLat     Float
  centerLon     Float
  distKm        Float
  // Extremos aproximados (redondeados a ~110 m) y registro de la
  // protección aplicada por extremo (snap de deriva ≤30 m, solo
  // recorte, sinSnap). El pin exacto del creador jamás se publica.
  inicioAproxLat Float?
  inicioAproxLon Float?
  finAproxLat    Float?
  finAproxLon    Float?
  proteccion     Json?
  // Elevación: null explícito cuando no hay datos — JAMÁS 0 ficticio.
  gainM      Float?
  lossM      Float?
  minEle     Float?
  maxEle     Float?
  eleFuente  String? // gpx | servicio | null
  // Dificultad física y técnica (1-5) separadas; la auto es sugerencia
  // orientativa que el creador ajusta (nunca se sobrescribe).
  dificultadFisica   Int
  dificultadTecnica  Int
  dificultadOrigen   String   @default("auto") // auto | creador
  // Atributos recreativos orientativos (máx 3): escénica, familiar,
  // recreativa, desafiante, principiantes, miradores, descanso.
  attrs              String[]
  // Vigencia informativa (v2.1 §7.4): los reportes NO mutan geometría.
  ultimaRevisionAt   DateTime?
  estadoVigencia     String   @default("vigente") // vigente | avisos | sin-revisar | retirada
  // Ciclo de vida: borrador local nunca llega al servidor; el servidor
  // conoce publicado | oculta (auto por reportes, reversible) | retirada.
  status    String    @default("publicado")
  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions     RouteVersion[]
  pois         RoutePoi[]
  photos       RoutePhoto[]
  favorites    RouteFavorite[]
  comments     RouteComment[]
  ratings      RouteRating[]
  reports      RouteReport[]
  experiences  RouteExperience[]

  @@index([cells], type: Gin)
  @@index([status, createdAt])
  @@index([ownerId, updatedAt])
}

// Historial de versiones publicadas: los rides y experiencias antiguos
// siguen anclados a la versión que recorrieron (id + v).
model RouteVersion {
  id               String   @id @default(cuid())
  routeId          String
  route            Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  v                Int
  geometrySnapshot String // polyline protegida de esta versión
  metaSnapshot     Json
  eleSnapshot      Json?
  publishedAt      DateTime @default(now())

  @@unique([routeId, v])
  @@index([routeId])
}

model RoutePoi {
  id      String @id @default(cuid())
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orden   Int    @default(0)
  lat     Float
  lon     Float
  tipo    String // agua | mirador | descanso | comida | desvio | otro
  nombre  String
  nota    String?

  @@index([routeId, orden])
}

model RoutePhoto {
  id            String   @id @default(cuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  url           String
  orden         Int      @default(0)
  blobPathname  String? // para el borrado físico del blob (fase E)
  hash          String?
  createdAt     DateTime @default(now())

  @@index([routeId, orden])
}

model RouteFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, routeId])
}

model RouteComment {
  id        String    @id @default(cuid())
  routeId   String
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String // ≤ 1000
  removedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([routeId, createdAt])
}

model RouteRating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  valor     Int // 1-5
  updatedAt DateTime @updatedAt

  @@unique([userId, routeId])
}

// Denuncias tipificadas (v2.1 §7): cierre | peligro | error_geografico |
// spam | contenido_inapropiado. Dedup por [ruta, reportante, motivo]
// (@@unique). peso y clasificacion se registran AL CREAR (umbral
// ponderado ≥2.0 contra denuncias coordinadas; lote sospechoso va
// siempre a cola).
model RouteReport {
  id            String   @id @default(cuid())
  routeId       String
  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  motivo        String
  estado        String   @default("abierta") // abierta | bajo_revision | confirmada | descartada | apelada
  peso          Float    @default(1)
  clasificacion String   @default("normal") // normal | sospechoso
  nota          String? // ≤ 500
  createdAt     DateTime @default(now())

  @@unique([routeId, reporterId, motivo])
  @@index([estado, createdAt])
}

// Experiencias comunitarias (v2.1 §6): texto + fotos + fecha, ancladas
// a la versión recorrida. JAMÁS escriben en Route. La pista GPS del
// ride no se sube: solo los metadatos elegidos.
model RouteExperience {
  id               String    @id @default(cuid())
  routeId          String
  route            Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeVersionId   String
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rideId           String? // ride que la originó (si vino de uno)
  fechaRealizacion String // ISO 8601 (fecha elegida o la del ride)
  comentario       String? // ≤ 2000
  condiciones      String[] // camino_ok | tramo_cerrado | barro | mucho_trafico | sombra | agua | otro (máx 3)
  observacion      String? // ≤ 500
  removedAt        DateTime?
  createdAt        DateTime  @default(now())
  photos           ExperiencePhoto[]

  @@unique([userId, routeId, fechaRealizacion])
  @@index([routeId, createdAt])
}

model ExperiencePhoto {
  id            String   @id @default(cuid())
  experienceId  String
  experience    RouteExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  url           String
  blobPathname  String?
  createdAt     DateTime @default(now())

  @@index([experienceId])
}

// Historial inmutable de moderación y apelaciones (v2.1 §7.3): cada
// acción registra actor, acción, objetivo, motivo y DETALLE (pesos y
// umbral aplicados) como base trazable de la decisión.
model ModerationLog {
  id         String   @id @default(cuid())
  actorId    String // sin FK: el log sobrevive al borrado de cuentas
  accion     String // report | autohide | restore | retire | appeal | resolve_appeal | delete_photo | purge
  targetType String // route | comment | experience | photo | report
  targetId   String
  motivo     String?
  detalle    Json?
  nota       String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// Cultura Ciclista (módulo del menú lateral, 2026-11-22): catálogo
// editorial propio de libros, películas y documentales ciclistas.
// El catálogo vive en esta base (no en APIs externas): las
// integraciones (Google Books / TMDB / Open Library) solo ENRIQUECEN
// metadatos vía scripts/ingesta-cultura.mjs con claves en el backend;
// los carruseles jamás dependen de un servicio externo para pintarse.
// ============================================================
model CulturaRecurso {
  id         String   @id @default(cuid())
  titulo     String
  // Reseña editorial propia (original de Cumbre30, es) — nunca texto
  // copiado de proveedores.
  resena     String
  // Tipo: libro | pelicula | documental
  tipo       String
  // Categorías (una o varias): mtb | aventura | historia | ruta |
  // entrenamiento | personas. Etiquetas se resuelven en i18n (cu.cat*).
  categorias String[]
  // Portada: hoy null → el cliente pinta portada procedural (paleta
  // determinista por recurso, sin hotlink ni dependencia de licencias
  // de terceros). La ingesta llena esta URL solo de fuentes cuyo uso
  // está permitido (p. ej. covers.openlibrary.org).
  portadaUrl String?
  // Año (string: admite "1978", "2023", "Serie", "Publicación").
  anio       String?
  // Autor, director o estudio/productora.
  autor      String
  // Dato extra disponible: duración, páginas, formato, etc.
  extra      String?
  pais       String?
  // Enlace legítimo externo (buscar/comprar/acceder): sin simulación
  // de reproducción ni compra dentro de la app.
  urlExterna String
  // Proveedor del metadato: editorial (semilla curada) | open_library |
  // google_books | tmdb.
  proveedor  String   @default("editorial")
  // Flujo editorial: borrador (false) → revisión → publicado (true).
  publicado  Boolean  @default(false)
  // Indicador de destacado: alimenta la fila superior del módulo.
  destacado  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  favoritos CulturaFavorito[]

  @@index([tipo])
  @@index([publicado, destacado])
  @@map("cultura_recursos")
}

model CulturaFavorito {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recursoId String
  recurso   CulturaRecurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, recursoId])
  @@map("cultura_favoritos")
}
